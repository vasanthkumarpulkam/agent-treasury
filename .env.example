# Copy this file to .env and fill in real values only when you're ready to go live.
# Nothing in this repo sends these values anywhere except the named provider's own API.

# --- Mode switch ---
# false (default) = paper trading, simulated fills, no real orders.
# true = LIVE. Requires all credentials below to be set and funded.
LIVE_MODE=false

# --- Polymarket (only needed for LIVE_MODE=true) ---
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- Bitcoin exchange (only needed for LIVE_MODE=true) ---
BTC_EXCHANGE=coinbase
BTC_EXCHANGE_API_KEY=
BTC_EXCHANGE_API_SECRET=
BTC_EXCHANGE_API_PASSPHRASE=

# --- Optional: data connectors (read-only, no trading capability) ---
COINDESK_API_KEY=
